{
  "name": "@circles/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "check:tokens": "! grep -rEn '#[0-9a-fA-F]{3,8}\\b|rgba?\\(|hsla?\\(|oklch\\(' src ../../packages/ui/src --include='*.tsx' --include='*.ts' --include='*.css' --exclude=tokens.css || (echo 'Raw color values found outside tokens.css' && exit 1)",
    "check:contrast": "node ../../scripts/check-contrast.mjs",
    "gen:types": "cd src-tauri && cargo test --lib export_bindings",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@circles/bindings": "workspace:*",
    "@circles/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "catalog:",
    "monaco-editor": "^0.57.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.2",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@circles/config": "workspace:*",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
